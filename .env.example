# Shared
NODE_ENV=development

# Supabase (Auth + Postgres)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Database (Prisma → Supabase Postgres)
# Runtime/serverless: Supavisor transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1
# Migrations/admin only: direct connection (port 5432).
DIRECT_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# API
PORT=3001
CORS_ORIGIN=http://localhost:3000
# Shop runtime uses Supabase/Prisma only. Do not set DATA_SOURCE=ninox.
# The Nest Ninox adapter is still a ping stub and does not read NINOX_*.
DATA_SOURCE=supabase

# One-shot Monday truck seed ONLY (`npm run prisma:seed-ninox-trucks --workspace=@ltl-shop/api`).
# GET TrucksDB E, upsert Shop trucks by VIN + truckNumber, then refuse to query Ninox again.
# Never write these values into NEXT_PUBLIC_*. Leave blank after the seed succeeds.
# NINOX_BASE_URL=https://lightningtransport.ninoxdb.com/v1
# NINOX_TOKEN=
# NINOX_TEAM_ID=
# NINOX_DATABASE_ID=
# NINOX_TIMEOUT_MS=20000
# NINOX_TRUCK_SEED_ALLOW_RERUN=0
# Local/dev only. Production and staging must omit this or set false.
AUTH_DEV_BYPASS=true

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# Yard Work Plan Slice 1 (LTR-34). Default off: Phase 1 six-gate assessment
# remains the Truck Detail / board derivation. Hooks at
# /api/admin/trucks/:id/work-plan* exist either way. Set true to also attach
# `workPlan` on GET /api/admin/trucks/:id.
# YARD_WORK_PLAN_SLICE1=true

# Server-only Lightning data-reporting-kit gateway for Admin Yard Phase 1 cards
# (Incoming Trucks, Upcoming Departures, Work location). Header x-agent-key.
# Never put this value in apps/web or any NEXT_PUBLIC_* variable.
# AGENT_REPORTING_KEY=
# AGENT_REPORTING_URL=https://aaqquwhdglueqlnbifvn.supabase.co/functions/v1/agent-reporting

# Observability (optional in local)
# Web client uses NEXT_PUBLIC_SENTRY_DSN. API uses SENTRY_DSN (falls back to the public DSN).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
