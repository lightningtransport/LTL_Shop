# Shared
NODE_ENV=development

# Supabase (Auth + Postgres)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (API). D22 / LTR-187: with SUPABASE_URL (or NEXT_PUBLIC_SUPABASE_URL) it lets the roster
# create Supabase Auth accounts with a temporary password, reset them, and clear must_change_password.
# Leave it unset locally: the roster then answers temporaryPassword: null. Never NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Database (Prisma → Supabase Postgres)
# Runtime/serverless: Supavisor transaction pooler (port 6543).
# D38 (P22): no connection_limit — production leaves Prisma's default pool (~5 per instance); =1 would run every
# Promise.all in the API one query at a time.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# Migrations/admin only: direct connection (port 5432).
DIRECT_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# API
PORT=3001
CORS_ORIGIN=http://localhost:3000
# D38 (P20): how long the API guard keeps a user in memory (ms). Default 30000; 0 turns it off.
# AUTH_USER_CACHE_TTL_MS=30000

# Web (server-only). D38 (P19): signs the Admin profile cookie so Admin navigation skips the API check.
# At least 32 random characters; never NEXT_PUBLIC_*. Unset = the middleware asks the API on every request.
# ADMIN_PROFILE_SECRET=
# Shop runtime uses Supabase/Prisma only. Do not set DATA_SOURCE=ninox.
# The Nest Ninox adapter is still a ping stub and does not read NINOX_*.
DATA_SOURCE=supabase

# One-shot Monday truck seed ONLY (`npm run prisma:seed-ninox-trucks --workspace=@ltl-shop/api`).
# GET TrucksDB E, upsert Shop trucks by VIN + truckNumber, then refuse to query Ninox again.
# Never write these values into NEXT_PUBLIC_*. Leave blank after the seed succeeds.
# NINOX_BASE_URL=https://lightningtransport.ninoxdb.com/v1
# NINOX_TOKEN=
# NINOX_TEAM_ID=
# NINOX_DATABASE_ID=
# NINOX_TIMEOUT_MS=20000
# NINOX_TRUCK_SEED_ALLOW_RERUN=0
# Local/dev only. Production and staging must omit this or set false.
# It also turns on /api/dev/demo/* for the local Demo panel (D36); without it those routes are 404.
AUTH_DEV_BYPASS=true

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# Yard Ready to Go window (LTR-90). ISO date: a truck whose Work Order was
# completed on or after it stays on the Yard board as Ready to Go until Return
# to Service. Unset: completed Work Orders leave the board.
# (YARD_WORK_PLAN_SLICE1/2 and WORK_PLAN_PM_PHASE were retired in LTR-150.)
# YARD_READY_TO_GO_SINCE=2026-09-25

# Server-only Lightning data-reporting-kit gateway for Admin Yard Phase 1 cards
# (Incoming Trucks, Upcoming Departures, Work location). Header x-agent-key.
# Never put this value in apps/web or any NEXT_PUBLIC_* variable.
# AGENT_REPORTING_KEY=
# AGENT_REPORTING_URL=https://aaqquwhdglueqlnbifvn.supabase.co/functions/v1/agent-reporting

# Samsara (D35, P12): server-only read token "LTL Shop" (Read Vehicles + Read Vehicle Statistics).
# Set it in the API's Vercel project only; never NEXT_PUBLIC, never in the repo. Without it Setup → Samsara says "not connected".
# SAMSARA_API_TOKEN=
# SAMSARA_API_URL=https://api.samsara.com
# SAMSARA_TIMEOUT_MS=20000

# Observability (optional in local)
# Web client uses NEXT_PUBLIC_SENTRY_DSN. API uses SENTRY_DSN (falls back to the public DSN).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
