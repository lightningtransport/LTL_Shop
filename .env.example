# Shared
NODE_ENV=development

# Supabase (Auth + Postgres)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Database (Prisma → Supabase Postgres)
# Runtime/serverless: Supavisor transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1
# Migrations/admin only: direct connection (port 5432).
DIRECT_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# API
PORT=3001
CORS_ORIGIN=http://localhost:3000
DATA_SOURCE=supabase
AUTH_DEV_BYPASS=true

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# Observability (optional in local)
# Web client uses NEXT_PUBLIC_SENTRY_DSN. API uses SENTRY_DSN (falls back to the public DSN).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
