{
  "name": "ltl-shop",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "start:local": "./start-local.sh",
    "dev:web": "npm run dev --workspace=@ltl-shop/web",
    "dev:api": "npm run dev --workspace=@ltl-shop/api",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run lint && npm test && npm run build",
    "test:e2e": "npm run test:e2e --workspace=@ltl-shop/web",
    "build:shared": "npm run build --workspace=@ltl-shop/shared",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run prisma:generate --workspace=@ltl-shop/api",
    "db:migrate": "npm run prisma:migrate --workspace=@ltl-shop/api",
    "db:seed": "npm run prisma:seed --workspace=@ltl-shop/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/client@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "@nestjs/core@12.0.1": true
  }
}
