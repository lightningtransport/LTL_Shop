{
  "source": "Product-owner seed contract 2026-09-20 + MappingTool declared-catalog TrucksDB E IDs",
  "tableId": "E",
  "tableName": "TrucksDB",
  "shopNameAuthority": "apps/api/prisma/schema.prisma model Truck",
  "mustHave": [
    { "shop": "truckNumber", "ninox": "E.A" },
    { "shop": "vin", "ninox": "E.CG", "when": "present" },
    { "shop": "make", "ninox": "E.DG", "when": "present" },
    { "shop": "model", "ninox": null, "when": "present — no declared Ninox field ID" },
    { "shop": "year", "ninox": "E.IJ", "when": "present" },
    { "shop": "licensePlate", "ninox": "E.HJ", "when": "present" },
    { "shop": "mileage", "ninox": "E.OF" },
    { "shop": "samsaraTruckLocation", "dto": "location", "ninox": "E.X1 / E.AN", "not": "Yard Presence" },
    { "shop": "samsaraLastConnectedDate", "dto": "locationUpdatedOn", "ninox": "E.X1 / E.AN if date-shaped" },
    { "shop": "company", "ninox": null, "when": "present — no declared Ninox field ID" },
    { "shop": "owner", "ninox": "E.VF", "when": "present" }
  ],
  "identity": {
    "uniqueWriteKey": "truckNumber",
    "preferredMatch": ["vin", "truckNumber"]
  },
  "optionalMetadataNeverReadiness": [
    { "ninox": "E.Y1", "meaning": "Shop Status", "shop": "ninoxMechanicStatus" },
    { "ninox": "E.TA", "meaning": "OutWork", "shop": null },
    { "ninox": "E.T5", "meaning": "unspecified optional", "shop": null },
    { "ninox": "E.BM", "meaning": "samsara vehicle id", "shop": "samsaraId" }
  ],
  "doNot": [
    "Set Presence / IN_YARD from E.X1",
    "Sync E.Y1 / E.TA / E.T5 / E.BM as board phases or Ready",
    "Import Work Order or job history"
  ]
}
