{
  "name": "@ltl-shop/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "../../node_modules/.bin/nest start --watch",
    "build": "node ../../node_modules/typescript/lib/tsc.js -p ../../packages/shared/tsconfig.json && ../../node_modules/.bin/prisma generate && ../../node_modules/.bin/nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "../../node_modules/.bin/tsc -p tsconfig.json --noEmit",
    "test": "../../node_modules/.bin/vitest run",
    "test:watch": "../../node_modules/.bin/vitest",
    "test:real": "../../node_modules/.bin/nest build && ../../node_modules/.bin/vitest run -c vitest.real.config.ts",
    "test:real:setup": "../../node_modules/.bin/tsx test-real/setup-db.ts",
    "prisma:generate": "../../node_modules/.bin/prisma generate",
    "prisma:migrate": "../../node_modules/.bin/prisma migrate dev",
    "prisma:seed": "../../node_modules/.bin/tsx prisma/seed.ts",
    "prisma:seed-ninox-trucks": "../../node_modules/.bin/tsx prisma/seed-ninox-trucks.ts",
    "prisma:normalize-truck-make-model": "../../node_modules/.bin/tsx prisma/normalize-truck-make-model.ts",
    "prisma:apply-catalog": "../../node_modules/.bin/tsx prisma/apply-job-catalog.ts",
    "prisma:reset-test-roster": "../../node_modules/.bin/tsx prisma/reset-test-roster.ts",
    "prisma:reset-demo-work-orders": "../../node_modules/.bin/tsx prisma/reset-demo-work-orders.ts",
    "prisma:demo-local": "../../node_modules/.bin/tsx prisma/demo-local.ts",
    "prisma:demo-publish-sql": "../../node_modules/.bin/tsx prisma/demo-publish-sql.ts",
    "prisma:release-status": "../../node_modules/.bin/tsx src/release/run-prisma-release-gate.ts --status --require-up-to-date",
    "prisma:release-deploy": "../../node_modules/.bin/tsx src/release/run-prisma-release-gate.ts --deploy --verify-api",
    "prisma:release-gate": "../../node_modules/.bin/tsx src/release/run-prisma-release-gate.ts --vercel-build",
    "prisma:release-verify": "../../node_modules/.bin/tsx src/release/run-prisma-release-gate.ts --verify-api"
  },
  "dependencies": {
    "@ltl-shop/shared": "*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.2.1",
    "@sentry/nestjs": "^10.74.0",
    "@supabase/supabase-js": "^2.47.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jose": "^5.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "../../node_modules/.bin/tsx prisma/seed.ts"
  }
}
