generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  mechanic
  manager
  admin
}

enum AppCapability {
  ADMIN_ACCESS           @map("admin.access")
  MECHANIC_STANDARD      @map("mechanic.standard")
  MECHANIC_PM            @map("mechanic.pm")
  YARD_OPERATIONS_MANAGE @map("yard.operations.manage")
  WORK_ORDERS_MANAGE     @map("work_orders.manage")
  QUALITY_CHECK_PERFORM  @map("quality_check.perform")
  // D41: a mechanic who can inspect trucks (the Manager always can). Granted in People.
  INSPECTION_PERFORM     @map("inspection.perform")
}

enum WorkOrderStatus {
  created
  in_progress
  waiting_paused
  completed
  cancelled
}

enum JobStatus {
  to_do
  completed
  cancelled
}

enum Priority {
  low
  normal
  high
  critical
}

enum PauseReason {
  waiting_for_parts
  waiting_for_approval
  waiting_for_vendor
  waiting_for_equipment
  waiting_for_bay
  waiting_for_driver
  truck_unavailable
  working_on_another_wo
  break
  end_of_shift
  other
}

// LTR-153 / D17: reasons a mechanic can give when a Job is blocked.
// PauseReason stays for the Manager's official Work Order pause.
enum BlockerReason {
  waiting_for_parts
  waiting_for_approval
  waiting_for_vendor
  waiting_for_equipment
  waiting_for_bay
  waiting_for_driver
  other
  quality_check_failed

  @@map("blocker_reason")
}

enum CatalogStatus {
  active
  inactive
}

enum ActivityEventType {
  work_order_created
  work_started
  job_added
  job_completed
  job_cancelled
  work_paused
  pause_reason_changed
  work_resumed
  blocker_reported
  blocker_resolved
  note_added
  work_request_handled
  mechanic_added
  mechanic_removed
  priority_changed
  notes_updated
  work_order_completed
  manager_correction
  pm_details_updated
  truck_mileage_corrected
  truck_returned_to_service
  readiness_assessment_started
  readiness_requirement_updated
  readiness_approved
  readiness_approval_invalidated
  readiness_assessment_closed
  // LTR-200 / D32: Parts & costs.
  vendor_saved
  part_catalog_updated
  part_purchase_saved
  part_purchase_voided
  outside_repair_saved
  outside_repair_voided
  // LTR-201 / D34.
  labor_rate_saved
  internal_invoice_sent
  internal_invoice_accepted
  internal_invoice_voided
  // LTR-57: the Custom Jobs review inbox.
  custom_jobs_reviewed
  // D41: the inspection sheet.
  inspection_saved
  inspection_defects_added
  inspection_checklist_updated
}

enum ReadinessAssessmentStatus {
  under_review
  ready
  closed
}

enum ReadinessRequirementType {
  inspection
  required_repairs
  pm
  alignment
  detailing
  quality_check
}

enum ReadinessRequirementOutcome {
  not_evaluated
  required
  not_required
  completed
  waived
}

enum TruckServiceStatus {
  in_service
  off_duty
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String
  role            UserRole  @default(mechanic)
  active          Boolean   @default(true)
  // LTR-199 / D31: removed from the Shop — out of every list and team for good; history stays.
  removedAt       DateTime? @map("removed_at")
  removedById     String?   @map("removed_by_id") @db.Uuid
  supabaseAuthId  String?   @unique @map("supabase_auth_id")
  ninoxExternalId String?   @map("ninox_external_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  createdWorkOrders              WorkOrder[]                @relation("WorkOrderCreatedBy")
  completedWorkOrders            WorkOrder[]                @relation("WorkOrderCompletedBy")
  mechanicAssignments            MechanicAssignment[]
  addedJobs                      WorkOrderJob[]             @relation("JobAddedBy")
  completedJobs                  WorkOrderJob[]             @relation("JobCompletedBy")
  assignedJobs                   WorkOrderJob[]             @relation("JobAssignedTo")
  sentExternalJobs               WorkOrderJob[]             @relation("JobSentExternalBy")
  pauseEvents                    PauseEvent[]               @relation("PauseCreatedBy")
  reportedPauseEvents            PauseEvent[]               @relation("PauseReportedBy")
  resolvedPauseEvents            PauseEvent[]               @relation("PauseResolvedBy")
  workSessions                   WorkSession[]
  workOrderNotes                 WorkOrderNote[]            @relation("WorkOrderNoteAuthor")
  handledWorkRequests            WorkOrderNote[]            @relation("WorkRequestHandledBy")
  activityLogs                   ActivityLog[]
  createdCatalogJobs             CatalogJob[]               @relation("CatalogJobCreatedBy")
  mileageAdjustments             TruckMileageAdjustment[]
  capabilities                   UserCapability[]           @relation("CapabilityUser")
  capabilitiesGranted            UserCapability[]           @relation("CapabilityGrantor")
  startedReadinessAssessments    TruckReadinessAssessment[] @relation("ReadinessAssessmentStartedBy")
  approvedReadinessAssessments   TruckReadinessAssessment[] @relation("ReadinessAssessmentApprovedBy")
  closedReadinessAssessments     TruckReadinessAssessment[] @relation("ReadinessAssessmentClosedBy")
  evaluatedReadinessRequirements ReadinessRequirement[]     @relation("ReadinessRequirementEvaluatedBy")
  truckServiceStatusEvents       TruckServiceStatusEvent[]
  defaultForWorkflowSteps        ShopWorkflowStep[]         @relation("ShopWorkflowStepDefaultMechanic")
  updatedWorkflowSteps           ShopWorkflowStep[]         @relation("ShopWorkflowStepUpdatedBy")
  workflowStepMemberships        ShopWorkflowStepMember[]   @relation("ShopWorkflowStepMemberUser")
  addedWorkflowStepMembers       ShopWorkflowStepMember[]   @relation("ShopWorkflowStepMemberAddedBy")
  removedBy                      User?                      @relation("UserRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  removedUsers                   User[]                     @relation("UserRemovedBy")
  updatedShopSettings            ShopSettings[]             @relation("ShopSettingsUpdatedBy")
  createdVendors                 Vendor[]                   @relation("VendorCreatedBy")
  createdPartPurchases           PartPurchase[]             @relation("PartPurchaseCreatedBy")
  voidedPartPurchases            PartPurchase[]             @relation("PartPurchaseVoidedBy")
  createdOutsideRepairs          OutsideRepair[]            @relation("OutsideRepairCreatedBy")
  createdLaborRates              LaborRate[]                @relation("LaborRateCreatedBy")
  createdInternalInvoices        InternalInvoice[]          @relation("InternalInvoiceCreatedBy")
  sentInternalInvoices           InternalInvoice[]          @relation("InternalInvoiceSentBy")
  acceptedInternalInvoices       InternalInvoice[]          @relation("InternalInvoiceAcceptedBy")
  voidedInternalInvoices         InternalInvoice[]          @relation("InternalInvoiceVoidedBy")
  voidedOutsideRepairs           OutsideRepair[]            @relation("OutsideRepairVoidedBy")
  uploadedAttachments            Attachment[]               @relation("AttachmentUploadedBy")
  createdTruckCostEntries        TruckCostEntry[]           @relation("TruckCostEntryCreatedBy")
  inspectionsDone                TruckInspection[]          @relation("TruckInspectionBy")
  inspectionDefectsAdded         TruckInspectionItem[]      @relation("TruckInspectionItemAddedBy")
  updatedInspectionItems         InspectionChecklistItem[]  @relation("InspectionChecklistItemUpdatedBy")
  updatedInspectionSettings      InspectionSettings[]       @relation("InspectionSettingsUpdatedBy")
  createdWorkOrderJobSources     WorkOrderJobSource[]       @relation("WorkOrderJobSourceCreatedBy")
  dismissedTruckFaults           TruckFault[]               @relation("TruckFaultDismissedBy")
  samsaraFaultCodeJobs           SamsaraFaultCodeJob[]
  deactivatedTrucks              Truck[]                    @relation("TruckDeactivatedBy")

  @@map("users")
}

model UserCapability {
  userId      String        @map("user_id") @db.Uuid
  capability  AppCapability
  grantedAt   DateTime      @default(now()) @map("granted_at")
  grantedById String?       @map("granted_by_id") @db.Uuid

  user      User  @relation("CapabilityUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("CapabilityGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, capability])
  @@index([capability])
  @@index([grantedById])
  @@map("user_capabilities")
}

model Truck {
  id                       String    @id @default(uuid()) @db.Uuid
  truckNumber              String    @unique @map("truck_number")
  make                     String?
  model                    String?
  year                     Int?
  mileage                  Int?
  company                  String?
  owner                    String?
  ninoxExternalId          String?   @map("ninox_external_id")
  /// Live production column. Kept on the Prisma model so migrate cannot DROP it.
  /// Not exposed on TruckDto (debug/internal only).
  samsaraId                Decimal?  @map("samsara_id") @db.Decimal
  /// Date-only last-connected value already stored on public.trucks. Display-only.
  samsaraLastConnectedDate DateTime? @map("samsara_last_connected_date") @db.Date
  /// Human address string (not lat/lng). Display-only. Never Yard Presence.
  samsaraTruckLocation     String?   @map("samsara_truck_location")
  vin                      String?
  /// Ninox E.X1 yard_location (fallback E.AN). Not Yard Presence.
  yardLocation             String?   @map("yard_location")
  /// Ninox E.TA mechanic_status (fallback E.Y1). Not a Yard Work Plan phase.
  ninoxMechanicStatus      String?   @map("ninox_mechanic_status")
  dispatcher               String?
  /// Declared catalog insurance E.Y4. Also used to fill `company` on first insert.
  insurance                String?
  licensePlate             String?   @map("license_plate")
  /// D35 / S-2: written only by the Samsara sync (OPEN_ISSUES §1x). Never `mileage`, never the Ninox columns above.
  /// D44: the Samsara vehicle this truck is connected to. Set means connected (the Manager, or the Ninox `samsara_id`); the sync never clears it.
  samsaraVehicleId         String?   @map("samsara_vehicle_id")
  /// Samsara's odometer in miles: a reference next to the official PM mileage (D10).
  samsaraOdometerMiles     Int?      @map("samsara_odometer_miles")
  /// `obd` (engine computer) or `gps` (Samsara's estimate when the ECU gives none).
  samsaraOdometerSource    String?   @map("samsara_odometer_source")
  samsaraOdometerAt        DateTime? @map("samsara_odometer_at")
  /// Reverse-geocoded address of the last GPS point. Display only, never Yard Presence.
  samsaraAddress           String?   @map("samsara_address")
  samsaraLatitude          Float?    @map("samsara_latitude")
  samsaraLongitude         Float?    @map("samsara_longitude")
  samsaraSpeedMph          Float?    @map("samsara_speed_mph")
  samsaraLocationAt        DateTime? @map("samsara_location_at")
  samsaraSyncedAt          DateTime? @map("samsara_synced_at")
  /// S3-4: the truck's dash lights from Samsara (J1939 gives STOP and warning per truck, not per code).
  samsaraStopLamp          Boolean?  @map("samsara_stop_lamp")
  samsaraWarningLamp       Boolean?  @map("samsara_warning_lamp")
  samsaraProtectLamp       Boolean?  @map("samsara_protect_lamp")
  samsaraEmissionsLamp     Boolean?  @map("samsara_emissions_lamp")
  samsaraLampsAt           DateTime? @map("samsara_lamps_at")
  /// D44: Samsara's name for the connected vehicle ("Truck 601"), kept by the connect and the sync. Display only.
  samsaraVehicleName       String?   @map("samsara_vehicle_name")
  /// D44: the sync saw a Samsara vehicle with this exact VIN. Only a proposal: the Manager connects it from the truck.
  samsaraProposedVehicleId String?   @map("samsara_proposed_vehicle_id")
  /// D44: out of the fleet. Hidden from lists, New Work Order and the sync; its history stays.
  deactivatedAt            DateTime? @map("deactivated_at") @db.Timestamptz(3)
  deactivatedById          String?   @map("deactivated_by_id") @db.Uuid
  deactivatedBy            User?     @relation("TruckDeactivatedBy", fields: [deactivatedById], references: [id], onDelete: SetNull)
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  workOrders           WorkOrder[]
  mileageAdjustments   TruckMileageAdjustment[]
  readinessAssessments TruckReadinessAssessment[]
  serviceStatusEvents  TruckServiceStatusEvent[]
  costEntries          TruckCostEntry[]
  partPurchaseLines    PartPurchaseLine[]
  outsideRepairs       OutsideRepair[]
  internalInvoices     InternalInvoice[]
  inspections          TruckInspection[]
  tireReadings         TireReading[]
  faults               TruckFault[]

  @@index([truckNumber])
  @@map("trucks")
}

enum TruckFaultProtocol {
  j1939
  obdii

  @@map("truck_fault_protocol")
}

/// D42: STOP, warning and check engine are the ones recommended as Jobs (S-6); pending and info are shown only.
enum TruckFaultSeverity {
  stop
  warning
  check_engine
  pending
  info

  @@map("truck_fault_severity")
}

/// D35 / S-3: one row per fault Samsara reports on a truck. Active while `clearedAt` is null; at most one active row per
/// truck and `faultKey` (partial unique index in the migration). The same code reported again later is a new row.
model TruckFault {
  id                  String             @id @default(uuid()) @db.Uuid
  truckId             String             @map("truck_id") @db.Uuid
  /// Stable identity of the code on this truck: `j1939:<source>:<spn>:<fmi>` or `obdii:<source>:<dtc>`.
  faultKey            String             @map("fault_key")
  protocol            TruckFaultProtocol
  /// What the screen shows: `SPN 3251 · FMI 0` or `P0087`.
  code                String
  description         String
  severity            TruckFaultSeverity
  spnId               Int?               @map("spn_id")
  fmiId               Int?               @map("fmi_id")
  dtcShortCode        String?            @map("dtc_short_code")
  /// The engine module that reported it (J1939 source address name or OBD-II tx id).
  sourceName          String?            @map("source_name")
  occurrenceCount     Int?               @map("occurrence_count")
  firstSeenAt         DateTime           @map("first_seen_at")
  lastSeenAt          DateTime           @map("last_seen_at")
  clearedAt           DateTime?          @map("cleared_at")
  /// D42 / S-6: "not now" with a reason; not recommended again until this row clears and the code comes back.
  dismissedAt         DateTime?          @map("dismissed_at")
  dismissedById       String?            @map("dismissed_by_id") @db.Uuid
  dismissReason       String?            @map("dismiss_reason")
  /// D42: Samsara reported this code again within 48 h after a Job for it was completed in that Work Order.
  cameBackWorkOrderId String?            @map("came_back_work_order_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  truck             Truck                @relation(fields: [truckId], references: [id], onDelete: Cascade)
  dismissedBy       User?                @relation("TruckFaultDismissedBy", fields: [dismissedById], references: [id], onDelete: SetNull)
  cameBackWorkOrder WorkOrder?           @relation("TruckFaultCameBack", fields: [cameBackWorkOrderId], references: [id], onDelete: SetNull)
  jobSources        WorkOrderJobSource[]

  @@index([truckId, clearedAt])
  @@index([clearedAt])
  @@map("truck_faults")
}

/// D35 / S-2: the one row (`id = 1`) that says how the last Samsara sync went. Setup → Samsara shows it.
model SamsaraSyncState {
  id            Int       @id @default(1)
  lastRunAt     DateTime? @map("last_run_at")
  lastSuccessAt DateTime? @map("last_success_at")
  lastError     String?   @map("last_error")
  lastTrigger   String?   @map("last_trigger")
  vehicles      Int       @default(0)
  trucksUpdated Int       @default(0) @map("trucks_updated")
  faultsOpened  Int       @default(0) @map("faults_opened")
  faultsCleared Int       @default(0) @map("faults_cleared")
  activeFaults  Int       @default(0) @map("active_faults")
  durationMs    Int       @default(0) @map("duration_ms")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("samsara_sync_state")
}

model TruckServiceStatusEvent {
  id          String             @id @default(uuid()) @db.Uuid
  truckId     String             @map("truck_id") @db.Uuid
  status      TruckServiceStatus
  reason      String
  workOrderId String?            @unique @map("work_order_id") @db.Uuid
  actorId     String             @map("actor_id") @db.Uuid
  occurredAt  DateTime           @default(now()) @map("occurred_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  truck     Truck      @relation(fields: [truckId], references: [id])
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  actor     User       @relation(fields: [actorId], references: [id])

  @@index([truckId, occurredAt])
  @@index([actorId])
  @@map("truck_service_status_events")
}

model TruckReadinessAssessment {
  id           String                    @id @default(uuid()) @db.Uuid
  truckId      String                    @map("truck_id") @db.Uuid
  status       ReadinessAssessmentStatus @default(under_review)
  version      Int                       @default(1)
  startedAt    DateTime                  @default(now()) @map("started_at")
  startedById  String                    @map("started_by_id") @db.Uuid
  readyAt      DateTime?                 @map("ready_at")
  approvedById String?                   @map("approved_by_id") @db.Uuid
  closedAt     DateTime?                 @map("closed_at")
  closedById   String?                   @map("closed_by_id") @db.Uuid
  closedReason String?                   @map("closed_reason")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")

  truck        Truck                  @relation(fields: [truckId], references: [id])
  startedBy    User                   @relation("ReadinessAssessmentStartedBy", fields: [startedById], references: [id])
  approvedBy   User?                  @relation("ReadinessAssessmentApprovedBy", fields: [approvedById], references: [id])
  closedBy     User?                  @relation("ReadinessAssessmentClosedBy", fields: [closedById], references: [id])
  requirements ReadinessRequirement[]
  workOrders   WorkOrder[]
  mutations    ReadinessMutation[]
  inspection   TruckInspection?

  @@index([truckId, status])
  @@index([status, updatedAt])
  @@index([startedById])
  @@map("truck_readiness_assessments")
}

model ReadinessMutation {
  idempotencyKey String   @id @map("idempotency_key")
  assessmentId   String   @map("assessment_id") @db.Uuid
  targetKey      String   @map("target_key")
  operation      String
  payloadHash    String   @map("payload_hash")
  actorId        String   @map("actor_id") @db.Uuid
  result         Json
  createdAt      DateTime @default(now()) @map("created_at")

  assessment TruckReadinessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId, createdAt])
  @@index([targetKey, operation, payloadHash])
  @@map("readiness_mutations")
}

model ReadinessRequirement {
  id                  String                      @id @default(uuid()) @db.Uuid
  assessmentId        String                      @map("assessment_id") @db.Uuid
  type                ReadinessRequirementType
  outcome             ReadinessRequirementOutcome @default(not_evaluated)
  waiverReason        String?                     @map("waiver_reason")
  evidenceWorkOrderId String?                     @map("evidence_work_order_id") @db.Uuid
  evaluatedById       String?                     @map("evaluated_by_id") @db.Uuid
  evaluatedAt         DateTime?                   @map("evaluated_at")
  version             Int                         @default(1)
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  assessment        TruckReadinessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  evidenceWorkOrder WorkOrder?               @relation("ReadinessRequirementEvidence", fields: [evidenceWorkOrderId], references: [id], onDelete: SetNull)
  evaluatedBy       User?                    @relation("ReadinessRequirementEvaluatedBy", fields: [evaluatedById], references: [id], onDelete: SetNull)

  @@unique([assessmentId, type])
  @@index([assessmentId, outcome])
  @@index([evidenceWorkOrderId])
  @@index([evaluatedById])
  @@map("readiness_requirements")
}

model JobCategory {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @unique
  status          CatalogStatus @default(active)
  sortOrder       Int           @default(0) @map("sort_order")
  ninoxExternalId String?       @map("ninox_external_id")
  // LTR-198 / D30: PM, Detailing and Quality Check are system Categories (locked); seed_key is the catalog load's id.
  systemKey       String?       @unique @map("system_key")
  seedKey         String?       @unique @map("seed_key")
  // D-SET9: why the Category is inactive (optional, one line).
  inactiveReason  String?       @map("inactive_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  catalogJobs   CatalogJob[]
  workOrders    WorkOrder[]
  workOrderJobs WorkOrderJob[]

  @@map("job_categories")
}

model CatalogJob {
  id              String        @id @default(uuid()) @db.Uuid
  categoryId      String        @map("category_id") @db.Uuid
  displayName     String        @map("display_name")
  status          CatalogStatus @default(active)
  ninoxExternalId String?       @map("ninox_external_id")
  // LTR-198 / D30: pm_a, pm_b, alignment, detailing, quality_check — found by key, never by name.
  systemKey       String?       @unique @map("system_key")
  seedKey         String?       @unique @map("seed_key")
  createdAt       DateTime      @default(now()) @map("created_at")
  createdById     String?       @map("created_by_id") @db.Uuid
  updatedAt       DateTime      @updatedAt @map("updated_at")

  category                 JobCategory               @relation(fields: [categoryId], references: [id])
  createdBy                User?                     @relation("CatalogJobCreatedBy", fields: [createdById], references: [id])
  aliases                  JobAlias[]
  workOrderJobs            WorkOrderJob[]
  workflowSteps            ShopWorkflowStep[]
  inspectionChecklistItems InspectionChecklistItem[]
  samsaraFaultCodes        SamsaraFaultCodeJob[]
  inspectionItems          TruckInspectionItem[]

  @@index([categoryId, status])
  @@map("catalog_jobs")
}

// LTR-156 / D15, D16: the mandatory steps every new truck Work Order starts with,
// each mapped to a catalog Job and an optional default mechanic. step_key values
// come from ShopWorkflowStepKey (shared); text keeps the list extensible.
// Runtime source of the mandatory Work Plan steps since LTR-157 (Setup → Shop workflow).
model ShopWorkflowStep {
  id                String   @id @default(uuid()) @db.Uuid
  stepKey           String   @unique @map("step_key")
  catalogJobId      String   @map("catalog_job_id") @db.Uuid
  defaultMechanicId String?  @map("default_mechanic_id") @db.Uuid
  sortOrder         Int      @default(0) @map("sort_order")
  active            Boolean  @default(true)
  updatedById       String?  @map("updated_by_id") @db.Uuid
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  catalogJob      CatalogJob               @relation(fields: [catalogJobId], references: [id])
  defaultMechanic User?                    @relation("ShopWorkflowStepDefaultMechanic", fields: [defaultMechanicId], references: [id], onDelete: SetNull)
  updatedBy       User?                    @relation("ShopWorkflowStepUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  // LTR-197 / D28: the step's team. One member → new Jobs are theirs; two or more → the team queue.
  members         ShopWorkflowStepMember[]

  @@map("shop_workflow_steps")
}

model ShopWorkflowStepMember {
  stepId    String   @map("step_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  addedById String?  @map("added_by_id") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at")

  step    ShopWorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  user    User             @relation("ShopWorkflowStepMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User?            @relation("ShopWorkflowStepMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([stepId, userId])
  @@index([userId])
  @@map("shop_workflow_step_members")
}

model JobAlias {
  id           String @id @default(uuid()) @db.Uuid
  catalogJobId String @map("catalog_job_id") @db.Uuid
  aliasText    String @map("alias_text")
  aliasNorm    String @unique @map("alias_norm")

  catalogJob CatalogJob @relation(fields: [catalogJobId], references: [id], onDelete: Cascade)

  @@index([catalogJobId])
  @@map("job_aliases")
}

model WorkOrder {
  id                     String          @id @default(uuid()) @db.Uuid
  displayId              String          @unique @map("display_id")
  truckId                String          @map("truck_id") @db.Uuid
  primaryCategoryId      String          @map("primary_category_id") @db.Uuid
  status                 WorkOrderStatus @default(created)
  priority               Priority        @default(normal)
  notes                  String?
  createdAt              DateTime        @default(now()) @map("created_at")
  createdById            String          @map("created_by_id") @db.Uuid
  startedAt              DateTime?       @map("started_at")
  completedAt            DateTime?       @map("completed_at")
  completedById          String?         @map("completed_by_id") @db.Uuid
  totalActiveLaborMs     BigInt          @default(0) @map("total_active_labor_ms")
  totalWaitingMs         BigInt          @default(0) @map("total_waiting_ms")
  idempotencyKey         String?         @unique @map("idempotency_key")
  idempotencyPayloadHash String?         @map("idempotency_payload_hash")
  idempotencyActorId     String?         @map("idempotency_actor_id") @db.Uuid
  version                Int             @default(1)
  ninoxExternalId        String?         @map("ninox_external_id")
  readinessAssessmentId  String?         @map("readiness_assessment_id") @db.Uuid
  updatedAt              DateTime        @updatedAt @map("updated_at")

  truck                         Truck                     @relation(fields: [truckId], references: [id])
  primaryCategory               JobCategory               @relation(fields: [primaryCategoryId], references: [id])
  createdBy                     User                      @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])
  completedBy                   User?                     @relation("WorkOrderCompletedBy", fields: [completedById], references: [id])
  jobs                          WorkOrderJob[]
  sessions                      WorkSession[]
  pauseEvents                   PauseEvent[]
  noteEntries                   WorkOrderNote[]
  mechanics                     MechanicAssignment[]
  activityLogs                  ActivityLog[]
  mutations                     WorkOrderMutation[]
  pmService                     PmService?
  mileageAdjustments            TruckMileageAdjustment[]
  readinessAssessment           TruckReadinessAssessment? @relation(fields: [readinessAssessmentId], references: [id], onDelete: SetNull)
  readinessEvidenceRequirements ReadinessRequirement[]    @relation("ReadinessRequirementEvidence")
  serviceStatusEvents           TruckServiceStatusEvent[]
  costEntries                   TruckCostEntry[]
  outsideRepairs                OutsideRepair[]
  inspections                   TruckInspection[]
  cameBackFaults                TruckFault[]              @relation("TruckFaultCameBack")

  @@index([status])
  @@index([truckId, status])
  @@index([createdById])
  @@index([readinessAssessmentId])
  @@index([updatedAt]) // PF10
  @@index([status, completedAt]) // PF10
  @@map("work_orders")
}

model WorkOrderMutation {
  idempotencyKey String   @id @map("idempotency_key")
  workOrderId    String   @map("work_order_id") @db.Uuid
  operation      String
  payloadHash    String   @map("payload_hash")
  actorId        String   @map("actor_id") @db.Uuid
  result         Json
  createdAt      DateTime @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId, createdAt])
  @@index([workOrderId, operation, payloadHash])
  @@map("work_order_mutations")
}

model PartCategory {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String   @unique
  aliases   String[] @default([])
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parts          Part[]
  pmServiceParts PmServicePart[]

  @@map("part_categories")
}

model Part {
  id              String     @id @default(uuid()) @db.Uuid
  categoryId      String     @map("category_id") @db.Uuid
  partNumber      String?    @map("part_number")
  displayName     String     @map("display_name")
  active          Boolean    @default(true)
  /// LTR-200 / D32: the reference cost in cents (D-PC6: set by the Manager). Never sent to the PM.
  unitCostCents   Int?       @map("unit_cost_cents")
  defaultVendorId String?    @map("default_vendor_id") @db.Uuid
  /// `seed` = from the base list; `app` = created by the Manager. Loading the base list never turns off or rewrites a part.
  source          PartSource @default(seed)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  category       PartCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  defaultVendor  Vendor?            @relation(fields: [defaultVendorId], references: [id], onDelete: SetNull)
  fitments       PartFitment[]
  pmServiceParts PmServicePart[]
  purchaseLines  PartPurchaseLine[]

  @@unique([categoryId, partNumber, displayName])
  @@index([categoryId, active])
  @@map("parts")
}

enum PartSource {
  seed
  app

  @@map("part_source")
}

/// LTR-200 / D32: who the Shop buys parts from or pays for outside repairs. Unique by lower(name) (SQL index).
model Vendor {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  doesParts     Boolean  @default(true) @map("does_parts")
  doesRepairs   Boolean  @default(false) @map("does_repairs")
  phone         String?
  email         String?
  accountNumber String?  @map("account_number")
  notes         String?
  active        Boolean  @default(true)
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  createdBy      User?            @relation("VendorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  parts          Part[]
  costEntries    TruckCostEntry[]
  purchases      PartPurchase[]
  outsideRepairs OutsideRepair[]

  @@map("vendors")
}

/// LTR-200 / D32 (PC-2): a parts invoice. Totals are computed by the API, in cents. Never deleted: void writes
/// reversals in the Truck cost ledger. Vendor + invoice number is unique among the ones not voided (SQL index).
model PartPurchase {
  id             String    @id @default(uuid()) @db.Uuid
  vendorId       String    @map("vendor_id") @db.Uuid
  invoiceNumber  String    @map("invoice_number")
  /// The number without spaces, dashes or capitals ("INV 88412093" = "inv88412093"): what "already saved" compares.
  invoiceNorm    String    @map("invoice_norm")
  invoiceDate    DateTime  @map("invoice_date") @db.Date
  subtotalCents  Int       @map("subtotal_cents")
  taxCents       Int       @default(0) @map("tax_cents")
  freightCents   Int       @default(0) @map("freight_cents")
  totalCents     Int       @map("total_cents")
  currency       String    @default("USD") @db.Char(3)
  notes          String?
  idempotencyKey String    @unique @map("idempotency_key")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  voidedAt       DateTime? @map("voided_at")
  voidedById     String?   @map("voided_by_id") @db.Uuid
  voidReason     String?   @map("void_reason")

  vendor    Vendor             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdBy User?              @relation("PartPurchaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  voidedBy  User?              @relation("PartPurchaseVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  lines     PartPurchaseLine[]

  @@index([invoiceDate])
  @@index([vendorId, invoiceNorm])
  @@map("part_purchases")
}

enum InternalInvoiceStatus {
  draft
  sent
  accepted
  void

  @@map("internal_invoice_status")
}

/// LTR-201 / D34 (LB-2): what the shop charges Finance for one truck and month — parts at cost, outside repairs and
/// labor, taken from the truck's cost ledger. A draft can lose lines; once sent it never changes (number, totals,
/// lines) and a later correction goes to the next invoice. Finance gets the PDF outside the app.
model InternalInvoice {
  id                   String                @id @default(uuid()) @db.Uuid
  /// SHOP-2026-0001, given when it is sent.
  number               String?               @unique
  truckId              String                @map("truck_id") @db.Uuid
  periodStart          DateTime              @map("period_start") @db.Date
  periodEnd            DateTime              @map("period_end") @db.Date
  status               InternalInvoiceStatus @default(draft)
  subtotalPartsCents   Int                   @default(0) @map("subtotal_parts_cents")
  subtotalOutsideCents Int                   @default(0) @map("subtotal_outside_cents")
  subtotalLaborCents   Int                   @default(0) @map("subtotal_labor_cents")
  totalCents           Int                   @default(0) @map("total_cents")
  currency             String                @default("USD") @db.Char(3)
  notes                String?
  createdById          String?               @map("created_by_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  sentAt               DateTime?             @map("sent_at")
  sentById             String?               @map("sent_by_id") @db.Uuid
  acceptedAt           DateTime?             @map("accepted_at")
  acceptedById         String?               @map("accepted_by_id") @db.Uuid
  voidedAt             DateTime?             @map("voided_at")
  voidedById           String?               @map("voided_by_id") @db.Uuid
  voidReason           String?               @map("void_reason")

  truck      Truck                 @relation(fields: [truckId], references: [id], onDelete: Restrict)
  createdBy  User?                 @relation("InternalInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sentBy     User?                 @relation("InternalInvoiceSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  acceptedBy User?                 @relation("InternalInvoiceAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  voidedBy   User?                 @relation("InternalInvoiceVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  lines      InternalInvoiceLine[]

  @@index([truckId, periodStart])
  @@index([status])
  @@map("internal_invoices")
}

/// One ledger row on an internal invoice (a copy of what it said). A ledger row is on at most one invoice that is not
/// voided (`active`, partial unique index): voiding frees its rows for another invoice.
model InternalInvoiceLine {
  id          String        @id @default(uuid()) @db.Uuid
  invoiceId   String        @map("invoice_id") @db.Uuid
  costEntryId String        @map("cost_entry_id") @db.Uuid
  kind        TruckCostKind
  description String
  occurredOn  DateTime      @map("occurred_on") @db.Date
  amountCents Int           @map("amount_cents")
  active      Boolean       @default(true)

  invoice   InternalInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  costEntry TruckCostEntry  @relation(fields: [costEntryId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([costEntryId])
  @@map("internal_invoice_lines")
}

/// LTR-201 / D34 (LB-1): the shop's labor rate per hour, from a date. A new rate starts a new row; a rate already
/// used is never edited. Labor = hours of closed sessions × the rate in effect the day each session started.
model LaborRate {
  id               String   @id @default(uuid()) @db.Uuid
  rateCentsPerHour Int      @map("rate_cents_per_hour")
  currency         String   @default("USD") @db.Char(3)
  effectiveFrom    DateTime @unique @map("effective_from") @db.Date
  notes            String?
  createdById      String?  @map("created_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  createdBy User? @relation("LaborRateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("labor_rates")
}

/// LTR-200 / D32 (PC-3): an invoice from an outside shop for one truck, optionally tied to the Job sent out (D24).
/// Same rules as a purchase: never deleted, void writes reversals; vendor + invoice number unique among the ones
/// not voided, across purchases too (the API checks both).
model OutsideRepair {
  id             String           @id @default(uuid()) @db.Uuid
  truckId        String           @map("truck_id") @db.Uuid
  vendorId       String           @map("vendor_id") @db.Uuid
  invoiceNumber  String           @map("invoice_number")
  invoiceNorm    String           @map("invoice_norm")
  invoiceDate    DateTime         @map("invoice_date") @db.Date
  description    String
  amountCents    Int              @map("amount_cents")
  currency       String           @default("USD") @db.Char(3)
  workOrderId    String?          @map("work_order_id") @db.Uuid
  workOrderJobId String?          @map("work_order_job_id") @db.Uuid
  /// A copy of what went out (part or truck) when it was tied to the Job.
  externalKind   JobExternalKind? @map("external_kind")
  notes          String?
  idempotencyKey String           @unique @map("idempotency_key")
  createdById    String?          @map("created_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  voidedAt       DateTime?        @map("voided_at")
  voidedById     String?          @map("voided_by_id") @db.Uuid
  voidReason     String?          @map("void_reason")

  truck        Truck         @relation(fields: [truckId], references: [id], onDelete: Restrict)
  vendor       Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  workOrder    WorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  workOrderJob WorkOrderJob? @relation(fields: [workOrderJobId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("OutsideRepairCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  voidedBy     User?         @relation("OutsideRepairVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  @@index([truckId, invoiceDate])
  @@index([vendorId, invoiceNorm])
  @@index([workOrderJobId])
  @@map("outside_repairs")
}

/// One line of a parts invoice. The truck is per line (D-PC9); description and part number are copies.
model PartPurchaseLine {
  id             String  @id @default(uuid()) @db.Uuid
  purchaseId     String  @map("purchase_id") @db.Uuid
  partId         String? @map("part_id") @db.Uuid
  description    String
  partNumber     String? @map("part_number")
  quantity       Decimal @db.Decimal(10, 2)
  unitCostCents  Int     @map("unit_cost_cents")
  lineTotalCents Int     @map("line_total_cents")
  truckId        String? @map("truck_id") @db.Uuid
  // D45 / ST-1 (LTR-221): the Job of its truck this part was bought for, if any. Changes P16 (D37).
  workOrderJobId String? @map("work_order_job_id") @db.Uuid
  sortOrder      Int     @default(0) @map("sort_order")

  purchase     PartPurchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  part         Part?         @relation(fields: [partId], references: [id], onDelete: SetNull)
  truck        Truck?        @relation(fields: [truckId], references: [id], onDelete: Restrict)
  workOrderJob WorkOrderJob? @relation(fields: [workOrderJobId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([partId])
  @@index([truckId])
  @@index([workOrderJobId])
  @@map("part_purchase_lines")
}

enum AttachmentOwnerType {
  part_purchase
  outside_repair
  internal_invoice

  @@map("attachment_owner_type")
}

/// LTR-200 / D32: an invoice file in the private Supabase Storage bucket. Written from PC-2 on.
model Attachment {
  id           String               @id @default(uuid()) @db.Uuid
  bucket       String
  objectPath   String               @map("object_path")
  fileName     String               @map("file_name")
  contentType  String               @map("content_type")
  sizeBytes    Int                  @map("size_bytes")
  sha256       String?
  ownerType    AttachmentOwnerType? @map("owner_type")
  ownerId      String?              @map("owner_id") @db.Uuid
  uploadedById String?              @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at")
  deletedAt    DateTime?            @map("deleted_at")

  uploadedBy User? @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([ownerType, ownerId])
  @@map("attachments")
}

enum TruckCostKind {
  part_purchase
  outside_repair
  labor
  internal_invoice

  @@map("truck_cost_kind")
}

/// LTR-200 / D32: the cost ledger of each Truck. Rows are never edited or deleted: a change writes a reversal.
/// Stage 1 writes `part_purchase` and `outside_repair` (from PC-2 on); `labor` and `internal_invoice` come later.
model TruckCostEntry {
  id              String        @id @default(uuid()) @db.Uuid
  truckId         String        @map("truck_id") @db.Uuid
  kind            TruckCostKind
  amountCents     Int           @map("amount_cents")
  currency        String        @default("USD") @db.Char(3)
  occurredOn      DateTime      @map("occurred_on") @db.Date
  sourceType      String        @map("source_type")
  sourceId        String        @map("source_id") @db.Uuid
  workOrderId     String?       @map("work_order_id") @db.Uuid
  vendorId        String?       @map("vendor_id") @db.Uuid
  description     String
  reversesEntryId String?       @map("reverses_entry_id") @db.Uuid
  createdById     String?       @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")

  truck        Truck                 @relation(fields: [truckId], references: [id], onDelete: Restrict)
  workOrder    WorkOrder?            @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  vendor       Vendor?               @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  reverses     TruckCostEntry?       @relation("TruckCostEntryReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversals    TruckCostEntry[]      @relation("TruckCostEntryReversal")
  invoiceLines InternalInvoiceLine[]
  createdBy    User?                 @relation("TruckCostEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([truckId, occurredOn])
  @@index([sourceType, sourceId])
  @@index([reversesEntryId]) // PF10
  @@index([workOrderId]) // PF10
  @@index([vendorId]) // PF10
  @@map("truck_cost_entries")
}

model PartFitment {
  id        String   @id @default(uuid()) @db.Uuid
  partId    String   @map("part_id") @db.Uuid
  make      String?
  model     String?
  createdAt DateTime @default(now()) @map("created_at")

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId])
  @@index([make, model])
  @@map("part_fitments")
}

model PmService {
  id              String   @id @default(uuid()) @db.Uuid
  workOrderId     String   @unique @map("work_order_id") @db.Uuid
  // LTR-141 / LTR-143: the PM job inside the truck's Work Order. Null for legacy PM Work Orders.
  workOrderJobId  String?  @unique @map("work_order_job_id") @db.Uuid
  observedMileage Int?     @map("observed_mileage")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workOrder    WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderJob WorkOrderJob?   @relation(fields: [workOrderJobId], references: [id], onDelete: SetNull)
  parts        PmServicePart[]

  @@map("pm_services")
}

model PmServicePart {
  id             String @id @default(uuid()) @db.Uuid
  pmServiceId    String @map("pm_service_id") @db.Uuid
  partCategoryId String @map("part_category_id") @db.Uuid
  partId         String @map("part_id") @db.Uuid

  pmService    PmService    @relation(fields: [pmServiceId], references: [id], onDelete: Cascade)
  partCategory PartCategory @relation(fields: [partCategoryId], references: [id])
  part         Part         @relation(fields: [partId], references: [id])

  @@unique([pmServiceId, partCategoryId])
  @@map("pm_service_parts")
}

model TruckMileageAdjustment {
  id              String   @id @default(uuid()) @db.Uuid
  truckId         String   @map("truck_id") @db.Uuid
  workOrderId     String   @map("work_order_id") @db.Uuid
  previousMileage Int?     @map("previous_mileage")
  observedMileage Int      @map("observed_mileage")
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  truck     Truck     @relation(fields: [truckId], references: [id])
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([truckId, createdAt])
  @@index([workOrderId])
  @@map("truck_mileage_adjustments")
}

model WorkOrderJob {
  id                 String           @id @default(uuid()) @db.Uuid
  workOrderId        String           @map("work_order_id") @db.Uuid
  catalogJobId       String?          @map("catalog_job_id") @db.Uuid
  categoryId         String           @map("category_id") @db.Uuid
  displayName        String           @map("display_name")
  customDescription  String?          @map("custom_description")
  isCustom           Boolean          @default(false) @map("is_custom")
  status             JobStatus        @default(to_do)
  addedAt            DateTime         @default(now()) @map("added_at")
  addedById          String           @map("added_by_id") @db.Uuid
  completedAt        DateTime?        @map("completed_at")
  completedById      String?          @map("completed_by_id") @db.Uuid
  cancelledAt        DateTime?        @map("cancelled_at")
  cancelledReason    String?          @map("cancelled_reason")
  // Manager review fields for custom jobs
  mappedCatalogJobId String?          @map("mapped_catalog_job_id") @db.Uuid
  reviewStatus       String?          @map("review_status")
  ninoxExternalId    String?          @map("ninox_external_id")
  // Manager-first ownership: optional per-Job assignment. Nullable so historical
  // Jobs stay valid and an unassigned Job visually inherits the WO general team.
  assignedMechanicId String?          @map("assigned_mechanic_id") @db.Uuid
  // LTR-141 / LTR-143: when the PM job was started (the end is completedAt).
  startedAt          DateTime?        @map("started_at")
  // LTR-188 / D23: a helper Job is its own Job (own owner, own clock) for another mechanic on the parent's work.
  helperOfJobId      String?          @map("helper_of_job_id") @db.Uuid
  // LTR-188 / D24: the Job is at an external shop while externalSince is set (status stays to_do).
  externalSince      DateTime?        @map("external_since")
  externalKind       JobExternalKind? @map("external_kind")
  externalNote       String?          @map("external_note")
  externalById       String?          @map("external_by_id") @db.Uuid
  // LTR-197 / D28: the Shop workflow step a mandatory Job belongs to; with no owner it sits in that step's team queue.
  workflowStepKey    String?          @map("workflow_step_key")
  // LTR-198 / SW5: the catalog System Job's key (pm_a, pm_b, alignment, detailing, quality_check); lanes read it first.
  systemKey          String?          @map("system_key")

  workOrder        WorkOrder            @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  catalogJob       CatalogJob?          @relation(fields: [catalogJobId], references: [id])
  category         JobCategory          @relation(fields: [categoryId], references: [id])
  addedBy          User                 @relation("JobAddedBy", fields: [addedById], references: [id])
  completedBy      User?                @relation("JobCompletedBy", fields: [completedById], references: [id])
  assignedMechanic User?                @relation("JobAssignedTo", fields: [assignedMechanicId], references: [id])
  externalBy       User?                @relation("JobSentExternalBy", fields: [externalById], references: [id], onDelete: SetNull)
  helperOf         WorkOrderJob?        @relation("JobHelperOf", fields: [helperOfJobId], references: [id], onDelete: SetNull)
  helpers          WorkOrderJob[]       @relation("JobHelperOf")
  pmService        PmService?
  outsideRepairs   OutsideRepair[]
  purchaseLines    PartPurchaseLine[]
  blockers         PauseEvent[]
  // D41 (and D42 later): the findings this Job came from — several per Job.
  sources          WorkOrderJobSource[]

  @@index([workOrderId, status])
  @@index([assignedMechanicId])
  @@index([helperOfJobId])
  @@index([workflowStepKey])
  @@index([completedById]) // PF10
  @@index([isCustom, reviewStatus]) // PF10
  @@index([externalSince]) // PF10
  @@map("work_order_jobs")
}

/// LTR-188 / D24: what went to the external shop — the part or the whole truck.
enum JobExternalKind {
  part
  truck

  @@map("job_external_kind")
}

model WorkSession {
  id          String                @id @default(uuid()) @db.Uuid
  workOrderId String                @map("work_order_id") @db.Uuid
  startedAt   DateTime              @map("started_at")
  endedAt     DateTime?             @map("ended_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  // LTR-153 / D18: labor is per mechanic. Nullable so historical sessions stay valid.
  userId      String?               @map("user_id") @db.Uuid
  // LTR-186 / D20, D21: why the app (not the mechanic) closed this session. Null for every other close.
  endReason   WorkSessionEndReason? @map("end_reason")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@index([workOrderId, userId])
  @@index([userId, endedAt])
  @@index([endedAt]) // PF10
  @@map("work_sessions")
}

/// LTR-186: day_close = the shop's day close (D20); switched_truck = the mechanic started on another Truck (D21).
enum WorkSessionEndReason {
  day_close
  switched_truck

  @@map("work_session_end_reason")
}

/// LTR-186 / D20: one row (id = 1). Shop hours the day close reads; the Manager edits them in Setup.
model ShopSettings {
  id              Int      @id @default(1)
  dayCloseMinutes Int      @default(1020) @map("day_close_minutes")
  /// ISO weekdays (Mon = 1 … Sun = 7).
  workdays        Int[]    @default([1, 2, 3, 4, 5])
  updatedById     String?  @map("updated_by_id") @db.Uuid
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  updatedBy User? @relation("ShopSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("shop_settings")
}

enum WorkOrderNoteKind {
  note
  work_request
}

// LTR-126 / D8: Work Order notes are append-only entries with author and time.
// A mechanic "work request" asks the Manager for additional work on the Truck.
model WorkOrderNote {
  id          String            @id @default(uuid()) @db.Uuid
  workOrderId String            @map("work_order_id") @db.Uuid
  kind        WorkOrderNoteKind @default(note)
  body        String
  authorId    String            @map("author_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")
  handledAt   DateTime?         @map("handled_at")
  handledById String?           @map("handled_by_id") @db.Uuid

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  author    User      @relation("WorkOrderNoteAuthor", fields: [authorId], references: [id])
  handledBy User?     @relation("WorkRequestHandledBy", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([workOrderId, createdAt])
  @@index([kind, handledAt]) // PF10
  @@map("work_order_notes")
}

model PauseEvent {
  id              String         @id @default(uuid()) @db.Uuid
  workOrderId     String         @map("work_order_id") @db.Uuid
  reason          PauseReason
  notes           String?
  startedAt       DateTime       @map("started_at")
  endedAt         DateTime?      @map("ended_at")
  durationMs      BigInt?        @map("duration_ms")
  createdById     String         @map("created_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  // Manager-first ownership: distinguish an official Work Order pause (Manager)
  // from a mechanic-reported blocker. Default true keeps historical rows as
  // official pauses. reportedById records the mechanic who raised the blocker.
  isOfficialPause Boolean        @default(true) @map("is_official_pause")
  reportedById    String?        @map("reported_by_id") @db.Uuid
  // LTR-98 / D3: a mechanic-reported blocker stays active until resolved.
  resolvedAt      DateTime?      @map("resolved_at")
  resolvedById    String?        @map("resolved_by_id") @db.Uuid
  // LTR-153 / D17: a blocker always belongs to one Job. Nullable for official
  // pauses and historical rows. blockerReason replaces reason for new blockers.
  jobId           String?        @map("job_id") @db.Uuid
  blockerReason   BlockerReason? @map("blocker_reason")

  workOrder  WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  job        WorkOrderJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdBy  User          @relation("PauseCreatedBy", fields: [createdById], references: [id])
  reportedBy User?         @relation("PauseReportedBy", fields: [reportedById], references: [id])
  resolvedBy User?         @relation("PauseResolvedBy", fields: [resolvedById], references: [id])

  @@index([workOrderId])
  @@index([jobId])
  @@index([workOrderId, isOfficialPause, resolvedAt]) // PF10
  @@map("pause_events")
}

model MechanicAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  workOrderId String    @map("work_order_id") @db.Uuid
  mechanicId  String    @map("mechanic_id") @db.Uuid
  addedAt     DateTime  @default(now()) @map("added_at")
  addedById   String    @map("added_by_id") @db.Uuid
  removedAt   DateTime? @map("removed_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  mechanic  User      @relation(fields: [mechanicId], references: [id])

  @@unique([workOrderId, mechanicId])
  @@index([mechanicId])
  @@map("mechanic_assignments")
}

model ActivityLog {
  id            String            @id @default(uuid()) @db.Uuid
  workOrderId   String?           @map("work_order_id") @db.Uuid
  eventType     ActivityEventType @map("event_type")
  entityType    String            @map("entity_type")
  entityId      String?           @map("entity_id")
  userId        String            @map("user_id") @db.Uuid
  previousValue Json?             @map("previous_value")
  newValue      Json?             @map("new_value")
  relevantValue Json?             @map("relevant_value")
  createdAt     DateTime          @default(now()) @map("created_at")

  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  user      User       @relation(fields: [userId], references: [id])

  @@index([workOrderId, createdAt])
  @@index([userId, createdAt]) // PF10
  @@index([entityType, eventType, createdAt]) // PF10
  @@map("activity_logs")
}

/// One-shot Monday TrucksDB E seed ledger. A completed row means the job
/// must not query Ninox again.
model NinoxTruckSeedRun {
  id                String    @id @default(uuid()) @db.Uuid
  sourceTableId     String    @map("source_table_id")
  status            String
  recordsRead       Int       @map("records_read")
  insertedCount     Int       @map("inserted_count")
  skippedCount      Int       @map("skipped_count")
  skippedNinoxQuery Boolean   @default(false) @map("skipped_ninox_query")
  notes             String?
  startedAt         DateTime  @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([status, sourceTableId])
  @@map("ninox_truck_seed_runs")
}

// ───────────────────────── D41: inspection sheet ─────────────────────────

enum InspectionSection {
  interior
  engine
  exterior

  @@map("inspection_section")
}

enum InspectionItemResult {
  ok
  defect
  na

  @@map("inspection_item_result")
}

/// D41: the 10 positions of a steer + 2 drive axle truck (trailers come later).
enum TirePosition {
  LF
  RF
  LFO
  LFI
  RFI
  RFO
  LRO
  LRI
  RRI
  RRO

  @@map("tire_position")
}

/// D41: ok, watch (near the limit, no Job) or fix (creates Flat Repair or Tires).
enum TireReadingStatus {
  ok
  watch
  fix

  @@map("tire_reading_status")
}

/// D41 / D42: what a Work Order Job came from. samsara_fault is used by Samsara S-6.
enum WorkOrderJobSourceKind {
  inspection_item
  tire_reading
  samsara_fault

  @@map("work_order_job_source_kind")
}

/// D41: the editable list (Setup → Inspection checklist). A defect creates `catalogJobId`, or becomes
/// a note on the mandatory step `workflowStepKey` (Detailing). Exactly one of the two (CHECK in SQL).
model InspectionChecklistItem {
  id              String            @id @default(uuid()) @db.Uuid
  section         InspectionSection
  label           String
  sortOrder       Int               @default(0) @map("sort_order")
  catalogJobId    String?           @map("catalog_job_id") @db.Uuid
  workflowStepKey String?           @map("workflow_step_key")
  active          Boolean           @default(true)
  /// The base list's id: the release only adds what is missing, never overwrites the Manager's edits.
  seedKey         String?           @unique @map("seed_key")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  updatedById     String?           @map("updated_by_id") @db.Uuid

  catalogJob      CatalogJob?           @relation(fields: [catalogJobId], references: [id])
  updatedBy       User?                 @relation("InspectionChecklistItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  inspectionItems TruckInspectionItem[]

  @@index([section, active, sortOrder])
  @@index([catalogJobId])
  @@map("inspection_checklist_items")
}

/// D41: one row (id = 1). Tire targets and limits; the Manager edits them in Setup.
model InspectionSettings {
  id             Int      @id @default(1)
  steerTargetPsi Int      @default(110) @map("steer_target_psi")
  driveTargetPsi Int      @default(95) @map("drive_target_psi")
  /// Minimum tread in 32nds of an inch (DOT: 4 steer, 2 drive).
  steerMinTread  Int      @default(4) @map("steer_min_tread")
  driveMinTread  Int      @default(2) @map("drive_min_tread")
  /// Percent away from target: past `watchPct` → watch, past `fixPct` → fix.
  watchPct       Int      @default(10) @map("watch_pct")
  fixPct         Int      @default(20) @map("fix_pct")
  updatedById    String?  @map("updated_by_id") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  updatedBy User? @relation("InspectionSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("inspection_settings")
}

/// D41: the saved inspection of one visit (one per readiness assessment). Read-only once saved;
/// "Add defects" only turns ok/na items into defects (D41 point 6).
model TruckInspection {
  id            String   @id @default(uuid()) @db.Uuid
  truckId       String   @map("truck_id") @db.Uuid
  assessmentId  String   @unique @map("assessment_id") @db.Uuid
  workOrderId   String?  @map("work_order_id") @db.Uuid
  inspectedById String   @map("inspected_by_id") @db.Uuid
  inspectedAt   DateTime @default(now()) @map("inspected_at")
  mileage       Int?
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  truck       Truck                    @relation(fields: [truckId], references: [id])
  assessment  TruckReadinessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder?               @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  inspectedBy User                     @relation("TruckInspectionBy", fields: [inspectedById], references: [id])
  items       TruckInspectionItem[]
  tires       TireReading[]

  @@index([truckId, inspectedAt])
  @@index([workOrderId])
  @@map("truck_inspections")
}

/// D41: one checked item, with a copy of the list item it used (section, label, Job or step), so later
/// edits to the list never change a saved inspection.
model TruckInspectionItem {
  id              String               @id @default(uuid()) @db.Uuid
  inspectionId    String               @map("inspection_id") @db.Uuid
  checklistItemId String?              @map("checklist_item_id") @db.Uuid
  section         InspectionSection
  label           String
  sortOrder       Int                  @map("sort_order")
  catalogJobId    String?              @map("catalog_job_id") @db.Uuid
  workflowStepKey String?              @map("workflow_step_key")
  result          InspectionItemResult
  note            String?
  /// Set when the defect came later through "Add defects" (null for the original save).
  addedLaterAt    DateTime?            @map("added_later_at")
  addedLaterById  String?              @map("added_later_by_id") @db.Uuid

  inspection    TruckInspection          @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checklistItem InspectionChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  catalogJob    CatalogJob?              @relation(fields: [catalogJobId], references: [id])
  addedLaterBy  User?                    @relation("TruckInspectionItemAddedBy", fields: [addedLaterById], references: [id], onDelete: SetNull)
  jobSources    WorkOrderJobSource[]

  @@unique([inspectionId, checklistItemId])
  @@index([inspectionId, result])
  @@map("truck_inspection_items")
}

/// D41: PSI and tread of one tire at one inspection, with the target and limit used then.
model TireReading {
  id           String            @id @default(uuid()) @db.Uuid
  inspectionId String            @map("inspection_id") @db.Uuid
  truckId      String            @map("truck_id") @db.Uuid
  position     TirePosition
  psi          Int
  /// 32nds of an inch.
  tread        Int
  targetPsi    Int               @map("target_psi")
  minTread     Int               @map("min_tread")
  status       TireReadingStatus
  readAt       DateTime          @default(now()) @map("read_at")

  inspection TruckInspection      @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  truck      Truck                @relation(fields: [truckId], references: [id])
  jobSources WorkOrderJobSource[]

  @@unique([inspectionId, position])
  @@index([truckId, position, readAt])
  @@map("tire_readings")
}

/// D41 / D42: a finding a Work Order Job came from. One Job can have several (Fog lamps + Brake lights
/// → Lights). Exactly one source id per row, matching `kind` (CHECK in SQL); Samsara S-6 adds
/// `samsaraFaultId`. Rows stay when the Job is cancelled: readers filter by the Job's status.
model WorkOrderJobSource {
  id               String                 @id @default(uuid()) @db.Uuid
  workOrderJobId   String                 @map("work_order_job_id") @db.Uuid
  kind             WorkOrderJobSourceKind
  inspectionItemId String?                @map("inspection_item_id") @db.Uuid
  tireReadingId    String?                @map("tire_reading_id") @db.Uuid
  /// D42 / S-6: the Samsara fault this Job takes care of.
  truckFaultId     String?                @map("truck_fault_id") @db.Uuid
  /// The finding as written ("Left hazard lamp lens cracked"), shown on the Job.
  note             String?
  createdAt        DateTime               @default(now()) @map("created_at")
  createdById      String?                @map("created_by_id") @db.Uuid

  workOrderJob   WorkOrderJob         @relation(fields: [workOrderJobId], references: [id], onDelete: Cascade)
  inspectionItem TruckInspectionItem? @relation(fields: [inspectionItemId], references: [id], onDelete: Cascade)
  tireReading    TireReading?         @relation(fields: [tireReadingId], references: [id], onDelete: Cascade)
  truckFault     TruckFault?          @relation(fields: [truckFaultId], references: [id], onDelete: Cascade)
  createdBy      User?                @relation("WorkOrderJobSourceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workOrderJobId, inspectionItemId])
  @@unique([workOrderJobId, tireReadingId])
  @@unique([workOrderJobId, truckFaultId])
  @@index([inspectionItemId])
  @@index([tireReadingId])
  @@index([truckFaultId])
  @@map("work_order_job_sources")
}

/// D42 / S-6: what the Manager picked for a fault code; the next time that code shows on any truck it comes suggested.
/// The key leaves out the engine module: `j1939:<spn>:<fmi>` or `obdii:<dtc>`.
model SamsaraFaultCodeJob {
  id           String   @id @default(uuid()) @db.Uuid
  codeKey      String   @unique @map("code_key")
  catalogJobId String   @map("catalog_job_id") @db.Uuid
  updatedById  String?  @map("updated_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  catalogJob CatalogJob @relation(fields: [catalogJobId], references: [id], onDelete: Cascade)
  updatedBy  User?      @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("samsara_fault_code_jobs")
}
